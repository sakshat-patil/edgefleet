CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# New images boot in PENDING_VERIFY; if they never call
# esp_ota_mark_app_valid_cancel_rollback() the bootloader reverts on next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SPIRAM=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# Lab networks serve firmware over plain HTTP from the in-cluster artifact server.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
